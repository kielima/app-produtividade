# Configuração do Supabase client (consumido pelo Vite) — backend de dados
# atual do app (Postgres + Auth + Edge Functions). Ver PLANO_MIGRACAO_SUPABASE.md.
VITE_SUPABASE_URL=https://robwqxgllzxbxwnjkyic.supabase.co
VITE_SUPABASE_ANON_KEY=

# OAuth 2.0 Web Client ID usado pelo Google Identity Services para abrir o
# consentimento do Google Calendar/Drive (uma vez), e pelo provider Google do
# Supabase Auth. Google Cloud Console > APIs & Services > Credentials > "Web
# client". O CLIENT SECRET correspondente NÃO vai aqui: fica só nos secrets
# das Edge Functions do Supabase (ver abaixo).
VITE_GOOGLE_OAUTH_CLIENT_ID=

# ---- Secrets das Edge Functions (NÃO são lidos pelo front/Vite) ----
# Configurar com `supabase secrets set NOME=valor` (ou no dashboard, Edge
# Functions > Secrets). O client secret é o mesmo "Web client" do Client ID
# acima; a chave do Gemini é usada só pelo proxy `call-gemini`.
#   supabase secrets set GOOGLE_OAUTH_CLIENT_SECRET=...
#   supabase secrets set GEMINI_API_KEY=...

# ---- Usada pelo script de CI que publica a versão do APK (scripts/publicar-firebase.mjs) ----
# service_role key do projeto Supabase — bypassa RLS, só usada em CI.
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================
# ---- Firebase: ainda em paralelo durante a migração p/ Supabase ----
# Firestore/Auth/Functions do Firebase continuam ativos como cópia fria por um
# período de segurança (ver PLANO_MIGRACAO_SUPABASE.md §7) — não usados pelo
# app em runtime, só pelo script de migração de dados (Admin SDK) abaixo.
# =============================================================

# Caminho pro service account JSON baixado do console Firebase.
# NUNCA commitar esse arquivo. Já coberto pelo .gitignore.
GOOGLE_APPLICATION_CREDENTIALS=/caminho/local/serviceAccount.json

# UID do dono no Firebase Auth (origem) — usado pelo script de migração pra
# ler users/{uid}/... do Firestore.
MIGRATE_UID=

# UID do dono no Supabase Auth (destino, um UUID) — usado pelo script de
# migração Firestore → Supabase pra gravar as linhas com o novo user_id.
MIGRATE_SUPABASE_UID=

# Caminhos pros arquivos .md de origem (locais, fora do repo) — usados só
# pelo bootstrap original (scripts/migrate/), não pela migração p/ Supabase.
MIGRATE_TASKS_FILE=/caminho/local/Minhas_Tarefas.md
MIGRATE_PROJECTS_FILE=/caminho/local/Meus_Projetos.md
MIGRATE_COMPLETED_FILE=/caminho/local/Tarefas_Concluidas.md
MIGRATE_MEMORY_DIR=/caminho/local/memory
